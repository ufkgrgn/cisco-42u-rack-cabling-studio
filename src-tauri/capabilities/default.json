{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default permissions for desktop app",
  "windows": ["main"],
  "permissions": [
    "allow-repository-snapshot",
    "allow-repository-commit",
    "allow-repository-secret",
    "allow-netbox-configure",
    "allow-netbox-get",
    "allow-netbox-forget",
    "allow-catalog-rerank",
    "allow-workspace-request",
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
