{
  "name": "cisco-42u-rack-cabling-studio",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bundle": "node scripts/build-bundles.cjs",
    "build": "node scripts/generate-stencil-manifest.cjs && npm run bundle && tsc -b && vite build && node scripts/copy-dist-assets.cjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-tauri.cjs",
    "tauri:android": "node scripts/build-android.cjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:legacy": "node tests/studio.test.cjs && node --test tests/editor.test.cjs tests/catalog.test.cjs && node tests/pixi-cabling-interaction.test.cjs",
    "test:performance": "node tests/performance.test.cjs",
    "test:performance:compare": "node tests/render-mode-comparison.cjs",
    "test:performance:matrix": "node scripts/pixi-performance-matrix.cjs",
    "test": "npm run test:unit && npm run test:legacy",
    "check:legacy": "node --check js/2d/app.js && node --check js/editor.js && node --check js/catalog-ui.js",
    "check": "node scripts/generate-stencil-manifest.cjs && npm run bundle && tsc --noEmit && npm run check:legacy",
    "start": "node scripts/serve.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "idb": "^8.0.2",
    "immer": "^10.1.1",
    "lucide": "^1.46.0",
    "lucide-react": "^0.475.0",
    "pixi.js": "^8.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.186.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.2.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
